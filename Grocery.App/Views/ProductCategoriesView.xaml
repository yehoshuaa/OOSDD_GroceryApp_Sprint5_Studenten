<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Grocery.App.Views.ProductCategoriesView"
             Title="Producten per categorie">
    <VerticalStackLayout Padding="12" Spacing="8">
        <Label Text="{Binding CategoryName}" FontSize="Large" />
        <CollectionView ItemsSource="{Binding Products}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="3*,2*,*,*">
                        <Label Grid.Column="0" Text="{Binding Name}" />
                        <Label Grid.Column="1" Text="{Binding Stock}" HorizontalOptions="End"/>
                        <Label Grid.Column="2" Text="{Binding ShelfLife}" HorizontalOptions="End"/>
                        <Label Grid.Column="3" Text="{Binding Price, StringFormat='€ {0:F2}'}" HorizontalOptions="End"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
