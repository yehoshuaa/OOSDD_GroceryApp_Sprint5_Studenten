<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grocery.App.Views.ProductCategoriesView"
             Title="Producten per categorie">
	<Grid Padding="12" ColumnDefinitions="*,16,*" RowDefinitions="Auto,*">
		<Label Text="{Binding CategoryName}" FontSize="Large" Grid.ColumnSpan="3" />

		<!-- Links: in categorie -->
		<VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
			<Label Text="In categorie" FontAttributes="Bold"/>
			<CollectionView ItemsSource="{Binding Assigned}" SelectionMode="Single">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="3*,2*,*,*">
							<Label Grid.Column="0" Text="{Binding Name}" />
							<Label Grid.Column="1" Text="{Binding Stock}" HorizontalOptions="End"/>
							<Label Grid.Column="2" Text="{Binding ShelfLife}" HorizontalOptions="End"/>
							<Label Grid.Column="3" Text="{Binding Price, StringFormat='€ {0:F2}'}" HorizontalOptions="End"/>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
				<CollectionView.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFromCategoryCommand}"
										  CommandParameter="{Binding .}" />
				</CollectionView.GestureRecognizers>
			</CollectionView>
		</VerticalStackLayout>

		<!-- Rechts: nog niet in categorie + zoek -->
		<VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="8">
			<Label Text="Beschikbaar (niet in categorie)" FontAttributes="Bold"/>
			<SearchBar Placeholder="Zoek product..."
					   Text="{Binding SearchText}"
					   SearchCommand="{Binding SearchCommand}" />
			<CollectionView ItemsSource="{Binding Available}" SelectionMode="Single">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="3*,2*,*,*">
							<Label Grid.Column="0" Text="{Binding Name}" />
							<Label Grid.Column="1" Text="{Binding Stock}" HorizontalOptions="End"/>
							<Label Grid.Column="2" Text="{Binding ShelfLife}" HorizontalOptions="End"/>
							<Label Grid.Column="3" Text="{Binding Price, StringFormat='€ {0:F2}'}" HorizontalOptions="End"/>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
				<CollectionView.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCategoryCommand}"
										  CommandParameter="{Binding .}" />
				</CollectionView.GestureRecognizers>
			</CollectionView>
		</VerticalStackLayout>
	</Grid>
</ContentPage>
