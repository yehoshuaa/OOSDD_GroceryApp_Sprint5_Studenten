<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grocery.App.Views.CategoriesView"
             Title="Categorieen">

	<CollectionView x:Name="CategoriesList"
					ItemsSource="{Binding Items}"
					SelectionMode="Single"
					SelectionChangedCommand="{Binding OpenCategoryAsyncCommand}"
					SelectionChangedCommandParameter="{Binding Source={x:Reference CategoriesList}, Path=CurrentSelection[0]}">

		<CollectionView.ItemTemplate>
			<DataTemplate>
				<Grid Padding="12">
					<Label Text="{Binding Name}" FontAttributes="Bold"/>
				</Grid>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</ContentPage>